MYSQL_DATABASE=museum
MYSQL_USER=museum_app
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MUSEUM_JWT_SECRET=replace-with-a-random-32-character-or-longer-local-secret
MUSEUM_BOOTSTRAP_ENABLED=true
MUSEUM_BOOTSTRAP_ADMIN_USERNAME=admin
MUSEUM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
MUSEUM_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
MUSEUM_MAIL_WEB_PORT=8025
MUSEUM_MAIL_FROM=no-reply@heluo.local
# Local Compose sends to Mailpit. Set these only when using an approved SMTP service.
# MUSEUM_SMTP_HOST=smtp.example.test
# MUSEUM_SMTP_PORT=587
# MUSEUM_SMTP_USERNAME=...
# MUSEUM_SMTP_PASSWORD=...
# MUSEUM_SMTP_AUTH=true
# MUSEUM_SMTP_STARTTLS=true
# Public HTTP(S) origin, without a path/query/credentials; used by email and live sitemap/robots.
# MUSEUM_PUBLIC_BASE_URL=https://museum.example.test
